#!/bin/bash
if [ -d "/var/jb" ]; then PREFIX="/var/jb"; else PREFIX=""; fi
echo "RTMPCamera: 开始安装..."
mkdir -p "$PREFIX/Applications/RTMPCameraApp.app"
mkdir -p "$PREFIX/usr/local/bin"
mkdir -p "$PREFIX/Library/MobileSubstrate/DynamicLibraries"
mkdir -p "$PREFIX/Library/LaunchDaemons"
chmod 755 "$PREFIX/usr/local/bin/RTMPDaemon" 2>/dev/null
chmod 755 "$PREFIX/Applications/RTMPCameraApp.app/RTMPCameraApp" 2>/dev/null
if [ -f "$PREFIX/Library/LaunchDaemons/com.rtmpcamera.daemon.plist" ]; then
    launchctl unload "$PREFIX/Library/LaunchDaemons/com.rtmpcamera.daemon.plist" 2>/dev/null
    launchctl load "$PREFIX/Library/LaunchDaemons/com.rtmpcamera.daemon.plist"
fi
if command -v uicache &>/dev/null; then uicache -p "$PREFIX/Applications"; fi

# Try DYLD_INSERT to inject into camera processes
/bin/launchctl setenv DYLD_INSERT_LIBRARIES "$PREFIX/Library/MobileSubstrate/DynamicLibraries/RTMPCameraTweak.dylib" 2>/dev/null || true
echo "RTMPCamera: DYLD_INSERT_LIBRARIES set"

echo "RTMPCamera: 安装完成"
exit 0