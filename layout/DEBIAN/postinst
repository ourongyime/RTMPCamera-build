#!/bin/bash
# postinst - RTMPCamera ?????
# ???? RootHide (/var/jb) ??? rootless

echo "RTMPCamera: ????..."

# ??????
if [ -d "/var/jb" ]; then
    JBROOT="/var/jb"
else
    JBROOT=""
fi

# ??????
mkdir -p "${JBROOT}/Applications/RTMPCameraApp.app"
mkdir -p "${JBROOT}/usr/local/bin"
mkdir -p "${JBROOT}/Library/MobileSubstrate/DynamicLibraries"
mkdir -p "${JBROOT}/Library/LaunchDaemons"

# ?????
chmod 755 "${JBROOT}/usr/local/bin/RTMPDaemon" 2>/dev/null || true
chmod 755 "${JBROOT}/Applications/RTMPCameraApp.app/RTMPCameraApp" 2>/dev/null || true

# ??????
if [ -f "${JBROOT}/Library/LaunchDaemons/com.rtmpcamera.daemon.plist" ]; then
    launchctl unload "${JBROOT}/Library/LaunchDaemons/com.rtmpcamera.daemon.plist" 2>/dev/null || true
    launchctl load "${JBROOT}/Library/LaunchDaemons/com.rtmpcamera.daemon.plist" 2>/dev/null || true
    echo "RTMPCamera: ???????"
fi

# ?????? - ??????????
echo "RTMPCamera: ??????..."
APP_PATH="${JBROOT}/Applications/RTMPCameraApp.app"
if [ -d "$APP_PATH" ]; then
    uicache -p "$APP_PATH" 2>/dev/null && echo "RTMPCamera: uicache OK ($APP_PATH)" || echo "RTMPCamera: uicache ????????"
else
    echo "RTMPCamera: App?????: $APP_PATH"
    # ????????
    uicache -p "/Applications/RTMPCameraApp.app" 2>/dev/null || true
fi

# ??????????
chmod 644 "${JBROOT}/Applications/RTMPCameraApp.app/AppIcon60x60@2x.png" 2>/dev/null || true
chmod 644 "${JBROOT}/Applications/RTMPCameraApp.app/AppIcon60x60@3x.png" 2>/dev/null || true

echo "RTMPCamera: ????. JBROOT=$JBROOT"
exit 0