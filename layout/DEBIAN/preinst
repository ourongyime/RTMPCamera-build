#!/bin/bash
# preinst - RTMPCamera ?????

echo "RTMPCamera: ?????..."

# ????????
for prefix in "/var/jb" ""; do
    if [ -f "${prefix}/Library/LaunchDaemons/com.rtmpcamera.daemon.plist" ]; then
        launchctl unload "${prefix}/Library/LaunchDaemons/com.rtmpcamera.daemon.plist" 2>/dev/null || true
        echo "RTMPCamera: ????????? (${prefix})"
    fi
done

echo "RTMPCamera: ????"
exit 0