#!/bin/bash
# prerm - RTMPCamera ?????
# CRITICAL: ??? unload daemon??????? MobileSubstrate dylib

if [ -d "/var/jb" ]; then
    PREFIX="/var/jb"
else
    PREFIX=""
fi

echo "RTMPCamera: ????..."

# 1. ???????
if [ -f "/Library/LaunchDaemons/com.rtmpcamera.daemon.plist" ]; then
    launchctl unload "/Library/LaunchDaemons/com.rtmpcamera.daemon.plist" 2>/dev/null
    echo "RTMPCamera: ???????"
fi

# 2. ?? LaunchDaemon plist
rm -f "/Library/LaunchDaemons/com.rtmpcamera.daemon.plist"

# 3. ?? daemon ???
rm -f "/usr/local/bin/RTMPDaemon"

# 4. ?? App
rm -rf "/Applications/RTMPCameraApp.app"

# 5. ????????
rm -f /tmp/rtmpcamera_shared_frame 2>/dev/null
rm -f /tmp/rtmpcamera_control 2>/dev/null

# 6. ??: ?????? MobileSubstrate ?? dylib
#    dpkg ????????????? ElleKit ??

# 7. ??????
if command -v uicache &>/dev/null; then
    uicache -p "/Applications" 2>/dev/null
fi

echo "RTMPCamera: ????"
exit 0