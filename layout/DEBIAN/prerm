#!/bin/bash
if [ -d "/var/jb" ]; then PREFIX="/var/jb"; else PREFIX=""; fi
echo "RTMPCamera: 开始卸载..."

# 强制停止旧进程
killall -9 RTMPDaemon 2>/dev/null || true
launchctl unload "$PREFIX/Library/LaunchDaemons/com.rtmpcamera.daemon.plist" 2>/dev/null || true
sleep 1

rm -f "$PREFIX/Library/LaunchDaemons/com.rtmpcamera.daemon.plist"
rm -f "$PREFIX/usr/local/bin/RTMPDaemon"
rm -rf "$PREFIX/Applications/RTMPCameraApp.app"
rm -f /tmp/rtmpcamera_shared_frame 2>/dev/null
rm -f /tmp/rtmpcamera_control 2>/dev/null
rm -f /var/mobile/Documents/rtmpcamera/tweak_loaded 2>/dev/null
rm -f /var/mobile/Documents/rtmpcamera/tweak.log 2>/dev/null

if command -v uicache &>/dev/null; then uicache -p "$PREFIX/Applications" 2>/dev/null; fi
echo "RTMPCamera: 卸载完成（已清理残留）"
exit 0