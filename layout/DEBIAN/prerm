#!/bin/bash
# prerm - RTMPCamera ?????

if [ -d "/var/jb" ]; then
    JBROOT="/var/jb"
else
    JBROOT=""
fi

echo "RTMPCamera: ????..."

# ??????
if [ -f "${JBROOT}/Library/LaunchDaemons/com.rtmpcamera.daemon.plist" ]; then
    launchctl unload "${JBROOT}/Library/LaunchDaemons/com.rtmpcamera.daemon.plist" 2>/dev/null || true
    echo "RTMPCamera: ???????"
fi

# ????
rm -f "${JBROOT}/Library/LaunchDaemons/com.rtmpcamera.daemon.plist"
rm -f "${JBROOT}/usr/local/bin/RTMPDaemon"
rm -rf "${JBROOT}/Applications/RTMPCameraApp.app"
rm -f /tmp/rtmpcamera_shared_frame 2>/dev/null
rm -f /tmp/rtmpcamera_control 2>/dev/null

# ??????
uicache -p "/Applications" 2>/dev/null || true

echo "RTMPCamera: ????"
exit 0