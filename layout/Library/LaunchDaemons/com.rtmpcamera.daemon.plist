<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rtmpcamera.daemon</string>
    <key>Program</key>
    <string>/var/jb/usr/local/bin/RTMPDaemon</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/jb/tmp/rtmpcamera_daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/var/jb/tmp/rtmpcamera_daemon.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>DYLD_LIBRARY_PATH</key>
        <string>/var/jb/usr/lib</string>
    </dict>
    <key>PlatformVariant</key>
    <string>Application</string>
</dict>
</plist>
